	local dn = ruleFolder:FindFirstChild("DisplayName")
	if not dn then
		dn = Instance.new("StringValue")
		dn.Name = "DisplayName"
		dn.Parent = ruleFolder
	end
	dn.Value = cleanName .. " [" .. vType .. "]"
