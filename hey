		Mesh = true, Texture = true, Animation = true, Animator = true, a = true, e = true
	}
	for _, desc in ipairs(model:GetDescendants()) do
		local n = desc.Name
		if not ignored[n] and n ~= model.Name and string.len(n) > 1 then
